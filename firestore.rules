rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin app: an admin is any user with a document in admins/{uid}
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User Profile
    match /User/{userId} {
      allow read, create, update, delete:
        if request.auth != null
        && request.auth.uid == userId;
      // Admin app: Customers screens
      allow read: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Products
    match /products/{productId} {
      allow read: if request.auth != null;
      // Admin app: add, edit, hide and delete products
      allow write: if isAdmin();
      // Customer app checkout: can only lower the stock
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }
    // Favorites
    match /User/{userId}/favorites/{productId} {
      allow read, write: if request.auth != null
                     && request.auth.uid == userId;
    }
    // Cart
    match /User/{userId}/cart/{productId} {
      allow read, write: if request.auth != null
                     && request.auth.uid == userId;
    }
    // Orders
    match /User/{userId}/orders/{orderId} {
      allow read, create: if request.auth != null
                      && request.auth.uid == userId;
      // Admin app: change the order status
      allow update: if isAdmin();
    }

    // Admin app: read every user's orders at once (collection group)
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }

    // Admin app: added by hand in the Firebase console, never from an app
    match /admins/{userId} {
      allow read: if request.auth != null
                && request.auth.uid == userId;
      allow write: if false;
    }

    // Admin app: sign up requests waiting for approval
    match /adminRequests/{userId} {
      allow create: if request.auth != null
                && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Admin app: store, shipping and payment settings
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin app: Contact Us messages
    match /supportMessages/{messageId} {
      allow create: if isAdmin();
    }
  }
}
